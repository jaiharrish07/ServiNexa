# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# PostgreSQL connection string (Project Settings -> Database -> Connection string -> URI)
# Used only by `npm run db:setup`; psql must be installed.
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres

# Optional AI microservice; the API uses local stubs when it is unavailable.
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=5000

# API server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
