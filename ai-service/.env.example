# ─── GroqCloud (GPT-OSS 20B, OpenAI-compatible) ───
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# ─── Free-tier budgets (enforced by rate_limiter) ───
GROQ_RPM=30
GROQ_TPM=8000
GROQ_DAILY_REQUESTS=1000
GROQ_DAILY_TOKENS=200000

# ─── Server ───
PORT=8000
# CORS allowlist for the service; "*" is fine (only the trusted Express backend calls it)
AI_CORS_ORIGINS=*
AI_SERVICE_TOKEN=replace-with-the-same-random-secret-in-backend-env-min-32-chars
